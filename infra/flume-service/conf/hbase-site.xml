<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  hbase-site.xml for Flume → HBase 2.x

  'zookeeper' resolves to your existing zookeeper container because both
  services share the ubuntu_default Docker network.
-->
<configuration>

  <property>
    <name>hbase.zookeeper.quorum</name>
    <value>zookeeper</value>
  </property>

  <property>
    <name>hbase.zookeeper.property.clientPort</name>
    <value>2181</value>
  </property>

  <!-- Must match HBASE_CONF_hbase_rootdir on your hbase-master container -->
  <property>
    <name>hbase.rootdir</name>
    <value>hdfs://hdfs-namenode:8020/hbase</value>
  </property>

  <property>
    <name>hbase.master</name>
    <value>hbase-master:60000</value>
  </property>

  <!-- Generous timeouts for containerised networking -->
  <property>
    <name>hbase.rpc.timeout</name>
    <value>60000</value>
  </property>

  <property>
    <name>hbase.client.retries.number</name>
    <value>10</value>
  </property>

</configuration>